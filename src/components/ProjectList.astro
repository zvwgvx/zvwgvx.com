---
import type { Project } from "../data/projects";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<div class="project-list">
  {projects.map((project) => (
    <article class="project-row">
      <div class="project-row-copy">
        <h3><a class="project-title" href={"/work/" + project.slug + "/"}>{project.name}<span aria-hidden="true"> ↗</span></a></h3>
        <p>{project.description}</p>
        <div class="project-row-meta"><span>{project.affiliation}</span><span class="mid-dot" aria-hidden="true">·</span><span>{project.phase}</span></div>
      </div>
      <span class="project-category">{project.category}</span>
    </article>
  ))}
</div>
