---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectList from "../components/ProjectList.astro";
import UpdateFeed from "../components/UpdateFeed.astro";
import { selectedProjects } from "../data/projects";
import { updates } from "../data/updates";
---

<BaseLayout>
  <section class="hero">
    <span class="eyebrow">Student researcher / systems engineering</span>
    <h1>Vu Truong Giang<span class="identity-dot">.</span></h1>
    <p class="hero-name-secondary">Zang Vu / @zvwgvx</p>
    <p class="hero-lede">Exploring persistent artificial agents and the systems that make them possible.</p>
    <p class="hero-summary">I'm an informatics-specialized student interested in autonomous digital entities, computational models of cognition, simulated affect and social behavior. I also build security tooling, backend infrastructure and systems software.</p>
    <div class="hero-links">
      <a href="/work/">Explore my work <span aria-hidden="true">↗</span></a>
      <a href="/cv/">Curriculum vitae <span aria-hidden="true">↗</span></a>
      <a href="https://github.com/zvwgvx" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      <a href="https://www.linkedin.com/in/zvwgvx" target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
      <a href="https://codeforces.com/profile/zvwg.vx" target="_blank" rel="noreferrer">Codeforces @zvwg.vx <span aria-hidden="true">↗</span></a>
    </div>
    <div class="hero-context">
      <p><span class="context-label">Affiliations</span><a href="https://sentialab.org" target="_blank" rel="noreferrer">SENTIA Lab ↗</a> · <a href="https://github.com/RiFT-Research" target="_blank" rel="noreferrer">RiFT Research ↗</a></p>
      <p><span class="context-label">Research interests</span>Persistent identity, cognitive architectures, affect, social cognition and autonomous agency</p>
    </div>
  </section>

  <section class="content-section" aria-labelledby="latest-updates">
    <div class="section-heading">
      <h2 id="latest-updates"><span class="section-index">01 /</span> Latest updates</h2>
      <a href="/updates/" class="text-link">All updates <span aria-hidden="true">↗</span></a>
    </div>
    <UpdateFeed items={updates.slice(0, 3)} />
  </section>

  <section class="content-section" aria-labelledby="selected-work">
    <div class="section-heading">
      <h2 id="selected-work"><span class="section-index">02 /</span> Selected work</h2>
      <a href="/work/" class="text-link">All projects <span aria-hidden="true">↗</span></a>
    </div>
    <ProjectList projects={selectedProjects} />
  </section>

  <section class="content-section" aria-labelledby="notes-heading">
    <div class="section-heading">
      <h2 id="notes-heading"><span class="section-index">03 /</span> Research & engineering notes</h2>
      <a href="/writing/" class="text-link">Writing <span aria-hidden="true">↗</span></a>
    </div>
    <a class="note-teaser" href="/writing/about-this-notebook/" style="display:block;color:inherit">
      <strong>About this notebook <span aria-hidden="true">↗</span></strong>
      <p>Research questions, architecture decisions, implementation notes and experiments — including what remains uncertain.</p>
    </a>
  </section>
</BaseLayout>
