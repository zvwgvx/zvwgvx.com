---
import BaseLayout from "../../layouts/BaseLayout.astro";
import UpdateFeed from "../../components/UpdateFeed.astro";
import { updates } from "../../data/updates";
---

<BaseLayout title="Updates — Vu Truong Giang" description="Awards, distinctions and selected public announcements from Vu Truong Giang.">
  <header class="page-intro">
    <span class="eyebrow">News / milestones</span>
    <h1>Updates</h1>
    <p>Competition results, academic distinctions and selected announcements.</p>
  </header>

  <section class="content-section" aria-labelledby="updates-all">
    <div class="section-heading">
      <h2 id="updates-all"><span class="section-index">01 /</span> Highlights & news</h2>
      <a class="text-link" href="/cv/">Honors in CV <span aria-hidden="true">↗</span></a>
    </div>
    <UpdateFeed items={updates} />
    <p class="updates-footnote">Dates show the confirmed month and year when available, otherwise only the reported year. Undated competitive-programming rankings are listed separately at the end.</p>
  </section>
</BaseLayout>
