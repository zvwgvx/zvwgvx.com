---
import BaseLayout from "../../layouts/BaseLayout.astro";
import UpdateFeed from "../../components/UpdateFeed.astro";
import { updates } from "../../data/updates";
---

<BaseLayout title="Updates — Vu Truong Giang" description="Updates, awards, research milestones and engineering notes from Vu Truong Giang.">
  <header class="page-intro">
    <span class="eyebrow">News / milestones</span>
    <h1>Updates</h1>
    <p>A chronological record of awards, selections and milestones, including earlier accomplishments. The homepage highlights the most recent entries.</p>
  </header>

  <section class="content-section" aria-labelledby="updates-all">
    <div class="section-heading">
      <h2 id="updates-all"><span class="section-index">01 /</span> Highlights & news</h2>
      <a class="text-link" href="/cv/">Honors in CV <span aria-hidden="true">↗</span></a>
    </div>
    <UpdateFeed items={updates} />
    <p class="updates-footnote">Dates use the reported month or year. The district-level Mathematics award is listed without a calendar year until confirmed.</p>
  </section>
</BaseLayout>
