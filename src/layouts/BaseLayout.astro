---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Giang Truong Vu — AI Research & Systems Engineering",
  description = "Personal website of Giang Truong Vu (Zang Vu / @zvwgvx). AI research, backend engineering, security and distributed systems."
} = Astro.props;

const pathname = Astro.url.pathname;
const current = (href: string) => href === "/" ? pathname === "/" : pathname.startsWith(href);
const navigation = [
  { href: "/work/", label: "Work" },
  { href: "/writing/", label: "Writing" },
  { href: "/about/", label: "About" },
  { href: "/cv/", label: "CV" }
];
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafaf8" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="zvwgvx" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      try {
        const preference = localStorage.getItem("zvwgvx-theme");
        if (preference === "light" || preference === "dark") {
          document.documentElement.dataset.theme = preference;
        }
      } catch {}
    </script>
  </head>
  <body>
    <div class="page">
      <header class="site-header shell">
        <a href="/" class="site-identity" aria-label="zvwgvx, homepage">
          <span class="identity-mark">zv<span class="identity-dot">.</span></span>
          <span class="identity-domain">zvwgvx.com</span>
        </a>
        <nav class="site-navigation" aria-label="Main navigation">
          {navigation.map((item) => (
            <a href={item.href} aria-current={current(item.href) ? "page" : undefined}>{item.label}</a>
          ))}
          <a class="nav-external" href="https://github.com/zvwgvx" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </nav>
        <button type="button" class="theme-toggle" data-theme-toggle aria-label="Toggle color theme" title="Toggle color theme">
          <span aria-hidden="true">◐</span>
        </button>
      </header>
      <main class="shell main-content" id="main">
        <slot />
      </main>
      <footer class="site-footer shell">
        <div class="footer-rule"></div>
        <div class="footer-content">
          <p>© {new Date().getFullYear()} Giang Truong Vu <span class="footer-muted">· @zvwgvx</span></p>
          <div class="footer-links">
            <a href="https://github.com/zvwgvx" target="_blank" rel="noreferrer">GitHub ↗</a>
            <a href="https://sentialab.org" target="_blank" rel="noreferrer">SENTIA Lab ↗</a>
            <a href="/cv/">CV</a>
          </div>
        </div>
      </footer>
    </div>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
      toggle?.addEventListener("click", () => {
        const root = document.documentElement;
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try {
          localStorage.setItem("zvwgvx-theme", next);
        } catch {}
      });
    </script>
  </body>
</html>
